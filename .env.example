# Application database
MYSQL_DATABASE=mbti_ai
MYSQL_USER=mbti
MYSQL_PASSWORD=mbti_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Redis
REDIS_PASSWORD=redis_dev_password

# Host ports (change these if the defaults are already in use)
MYSQL_PORT=13306
REDIS_PORT=16379
BACKEND_PORT=8080
FRONTEND_PORT=5173

# AI provider: mock works without a key; set deepseek/openai-compatible for a real model
AI_ENABLED=true
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_MAX_HISTORY_MESSAGES=20
AI_MOCK_DELAY_MILLIS=0
